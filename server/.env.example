PORT=5000
MONGO_URI=your-mongodb-connection-string
# Comma-separated list of allowed frontend origins (Vercel URL + localhost)
CLIENT_URL=http://localhost:5173,https://your-app.vercel.app
NODE_ENV=production

# Render sets this automatically — do NOT set it manually on Render.
# Only set SELF_URL below if deploying to a host that does NOT auto-provide
# a public URL env var (Render provides RENDER_EXTERNAL_URL for you).
# SELF_URL=https://your-backend.onrender.com
